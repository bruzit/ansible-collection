[Interface]
Address = {{ wireguard_address }}
{% if wireguard_egress_interface %}
ListenPort = {{ wireguard_port }}
{% endif %}
{% if wireguard_routes %}
Table = off
{% endif %}
PostUp = wg set %i private-key /etc/wireguard/%i.key{% for peer in wireguard_peers %} peer {{ peer.public_key }} preshared-key /etc/wireguard/%i-{{ peer.name }}.psk{% endfor %}

{% for route in wireguard_routes %}
PostUp = ip route add {{ route }} dev %i
{% endfor %}
{% for peer in wireguard_peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}:{{ wireguard_port }}
PersistentKeepalive = 25
{% endif %}
{% endfor %}
